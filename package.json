{
  "name": "agent-extensions",
  "license": "MIT",
  "private": true,
  "workspaces": ["plugins/*", "packages/*"],
  "scripts": {
    "build": "bun run build:packages && bun run build:plugins",
    "build:packages": "bun run scripts/build-packages.ts",
    "build:plugins": "bun run scripts/build-plugins.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rslib/core": "^0.19.0",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
