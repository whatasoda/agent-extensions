{
  "name": "agent-extensions",
  "license": "MIT",
  "private": true,
  "workspaces": ["plugins/*", "packages/*"],
  "scripts": {
    "build": "cd packages/soda && bun run build",
    "test": "cd packages/soda && bun run test",
    "typecheck": "cd packages/soda && tsc --noEmit",
    "publish-public": "cd packages/soda && bun run build && npm publish --access public",
    "publish-local": "bun scripts/publish-local.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
